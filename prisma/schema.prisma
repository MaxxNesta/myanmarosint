generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Stage 1: Raw ingestion ───────────────────────────────────────────────────
// Populated by cron/scrape — RSS feeds and Telegram channels.
// url is nullable to support Telegram messages that have no web URL.

model RawArticle {
  id             String          @id @default(cuid())
  url            String?         @unique          // null for Telegram
  channelName    String                           // RSS feed name or Telegram channel
  title          String
  content        String
  location       String?                          // raw location text from source
  publishedAt    DateTime?
  ingestedAt     DateTime        @default(now())
  sourceType     String          @default("RSS")  // RSS | TELEGRAM
  conflictEvents ConflictEvent[]

  @@index([ingestedAt])
  @@index([channelName])
  @@index([sourceType])
}

// ─── Stage 2: Groq conflict extraction ───────────────────────────────────────
// Populated by cron/extract — Groq reads each RawArticle and extracts
// one structured conflict event. Dedup via dedupHash prevents duplicates.

model ConflictEvent {
  id            String            @id @default(cuid())
  rawArticleId  String
  rawArticle    RawArticle        @relation(fields: [rawArticleId], references: [id])
  eventType     ConflictEventType
  date          DateTime
  region        String
  adminArea     String?
  location      String?
  lat           Float?
  lng           Float?
  summary       String            // raw Groq extraction summary
  fatalities    Int               @default(0)
  fatalitiesMin Int               @default(0)
  fatalitiesMax Int               @default(0)
  biasFlag      String            @default("neutral")
  dedupHash     String            @unique
  createdAt     DateTime          @default(now())
  analysedEvent AnalysedEvent?

  @@index([date])
  @@index([region])
  @@index([eventType])
  @@index([lat, lng])
  @@index([rawArticleId])
}

// ─── Stage 3: DeepSeek intelligence analysis ─────────────────────────────────
// Always created alongside ConflictEvent (Option A).
// If DeepSeek fails: attackerActor/defenderActor are null, confidence = 0.4,
// summary falls back to Groq's raw summary.

model AnalysedEvent {
  id                   String        @id @default(cuid())
  conflictEventId      String        @unique
  conflictEvent        ConflictEvent @relation(fields: [conflictEventId], references: [id], onDelete: Cascade)
  attackerActor        String?
  defenderActor        String?
  actors               String[]
  confidence           Float         @default(0.4)
  summary              String        // DeepSeek intelligence summary (or Groq fallback)
  isActiveIntelligence Boolean       @default(true)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([confidence])
  @@index([isActiveIntelligence])
  @@index([createdAt])
}

// ─── Supporting tables ────────────────────────────────────────────────────────

model RateLimit {
  key       String   @id       // "ip:endpoint:windowHour"
  hits      Int      @default(1)
  expiresAt DateTime

  @@index([expiresAt])
}

model SourceStats {
  id               String   @id @default(cuid())
  sourceName       String   @unique
  totalEvents      Int      @default(0)
  corroborated     Int      @default(0)
  contradicted     Int      @default(0)
  reliabilityScore Float    @default(0.65)
  lastUpdated      DateTime @updatedAt

  @@index([sourceName])
}

model UpdateLog {
  id        String   @id @default(cuid())
  timestamp DateTime @default(now())
  change    String
  reason    String
  source    String?
  metadata  Json?

  @@index([timestamp])
}

model SimulationResult {
  id             String   @id @default(cuid())
  scenarioParams Json
  results        Json
  iterations     Int
  runAt          DateTime @default(now())

  @@index([runAt])
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum ConflictEventType {
  CLASH
  AIRSTRIKE
  ARTILLERY_SHELLING
  SIEGE_SEIZED
  RECAPTURED
  DISPLACEMENT
  HUMANITARIAN_CRISIS
  POLITICAL_DEVELOPMENT
}
